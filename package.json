{
  "name": "elvion-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "smoke:package": "node scripts/smoke-package.mjs",
    "build": "node scripts/build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "zod": "^4.1.12",
    "react": "^19.2.0",
    "ink": "^6.6.0",
    "string-width": "^8.1.0"
  }
}
